# From @BotFather (/newbot). Keep secret — it is full control of the bot.
TELEGRAM_BOT_TOKEN=

# Comma-separated NUMERIC Telegram user IDs that get paged for P0/P1 and can
# run /stats and /resolve. Get yours by messaging @userinfobot.
# Each operator MUST send /start to the bot once, or Telegram blocks the DM.
SUPPORT_ALERT_USER_IDS=

# Optional. Omit and tickets log to stdout only; the bot still works.
DATABASE_URL=postgres://plague:PASSWORD@postgres:5432/plague
