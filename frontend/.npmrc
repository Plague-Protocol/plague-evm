# MiniPay Mini App dependency-security requirements.
# https://docs.minipay.xyz/getting-started/submit-your-miniapp.html
#
# ⚠️ npm IGNORES a .npmrc inside a workspace package when the install runs in
# workspace mode — it prints `npm warn config ignoring workspace config at
# frontend/.npmrc` and moves on. This file therefore only takes effect when npm
# runs against frontend/ standalone. It is kept because it documents the intent
# and is correct in that case; it is NOT the enforcement point.
#
# Enforcement lives in two places instead:
#   1. Exact version pins in package.json (below is belt-and-braces for future
#      `npm i` calls) + the committed root package-lock.json + `npm ci`.
#   2. `NPM_CONFIG_IGNORE_SCRIPTS=true` set as a Vercel project env var, which
#      applies to the real production install regardless of workspace mode.
#
# Do NOT move ignore-scripts to the ROOT .npmrc. Nine transitive deps genuinely
# need install scripts — @prisma/client, @prisma/engines, prisma, esbuild,
# keccak, unrs-resolver, bufferutil, utf-8-validate, fsevents — and backend/
# and agents/ would silently install without Prisma engines. Verified 2026-08-11
# that the *frontend* alone builds clean with scripts skipped, which is why the
# Vercel-level switch is safe and the root-level one is not.

# No install-time script execution — the main supply-chain kill switch.
ignore-scripts=true

# Refuse any version published less than 7 days ago (value is in minutes).
# Blunts the window in which a hijacked package can be pulled in. Requires
# npm >= 11.5; older npm ignores the key rather than failing.
minimum-release-age=10080

# Exact pins on save, so `npm i <pkg>` can't reintroduce a caret range.
save-exact=true
