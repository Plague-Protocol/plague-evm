# From @BotFather (/newbot). A SEPARATE bot from the support bot's token:
# that one is DM'd by players, this one should only be findable by whoever
# runs the X account. Keep secret, it is full control of the bot.
X_BOT_TELEGRAM_TOKEN=

# Comma-separated NUMERIC Telegram user IDs that receive drafts. Message this
# bot /whoami to get yours.
# Each operator MUST message the bot once, or Telegram blocks the DM.
X_OPERATOR_IDS=

# Required. Drafts and the aggregate stats both live here.
DATABASE_URL=postgres://plague:PASSWORD@postgres:5432/plague

# UTC hour the day's draft is written. One per day regardless of restarts.
X_DRAFT_HOUR_UTC=9
