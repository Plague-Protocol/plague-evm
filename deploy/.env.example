# Copy to deploy/.env and fill in. This file is read by docker compose for
# ${VAR} substitution. deploy/.env is gitignored — never commit real secrets.

# ── Public API domain (Caddy auto-TLS) ──────────────────────────────────────
# DNS A record for this must point at the VPS public IP.
API_DOMAIN=api.zplague.xyz

# Origin allowed by backend CORS (your frontend). zplague.xyz + www are also
# hardcoded in the backend; set this to your primary frontend origin.
FRONTEND_URL=https://zplague.xyz

# ── Celo RPC (keyed upstream strongly recommended) ──────────────────────────
# The backend's /api/rpc proxy serves the whole floor's browser chain-polling
# from THIS one IP, and public Celo nodes (forno, drpc) rate-limit by IP — under
# load they 5xx and the proxy 502s. Point CELO_RPC_URL at a keyed endpoint so
# the proxy (and the backend signer) lean on that; public nodes stay as
# fallbacks. Both default to public if unset, so this whole section is optional.
#   Alchemy: https://celo-mainnet.g.alchemy.com/v2/<KEY>
#   dRPC:    https://lb.drpc.org/ogrpc?network=celo&dkey=<KEY>
#   Infura:  https://celo-mainnet.infura.io/v3/<KEY>
# CELO_RPC_URL=https://celo-mainnet.g.alchemy.com/v2/YOUR_KEY
# CELO_RPC_FALLBACK_URLS=https://forno.celo.org,https://celo.drpc.org
# Both the backend AND the agents fan out over this same primary + fallbacks.

# ── Backend chain event-poll cadence (optional) ─────────────────────────────
# The backend polls contract events via eth_getLogs, fast while a game is live
# and slow when idle. Defaults (compose): 10s active / 60s idle — the 60s idle
# keeps idle RPC burn ~2.6M CU/mo. Lower idle for faster bot self-play pickup,
# raise it to save more. Human games are unaffected (instant via socket join).
# CHAIN_EVENT_POLL_MS=10000
# CHAIN_EVENT_IDLE_POLL_MS=60000

# ── Self-hosted Postgres ────────────────────────────────────────────────────
# Strong random string. Used by both the postgres container and DATABASE_URL.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# ── Backend secrets ─────────────────────────────────────────────────────────
# Mainnet signer (beginActivePhase/assignInfection/openVoting/resolveRound).
# Fund with a little CELO for gas.
BACKEND_PRIVATE_KEY=0x...
# Shared secret authenticating the agent runner to the backend bot API.
# The agents service reuses this same value below.
BOT_RUNNER_SECRET=change-me-to-a-long-random-string

# ── Agent tuning (optional — sensible defaults in compose) ───────────────────
STAKE_AMOUNT=100000000000000
BOT_MAX_STAKE_WEI=10000000000000000
SELF_PLAY_IDLE_MS=300000
CYCLE_DELAY_MS=30000
# Set true to stop bots starting self-play games (they still join human rooms).
SELF_PLAY_DISABLED=false
# Gas floor (wei of native CELO): bots below this are excluded from games.
# A full game spends ~0.55 CELO, but the node's pre-flight balance check needs
# gasLimit×maxFeePerGas ≈ 0.92 CELO for the ZK commit (baseFeeMultiplier 2);
# a bot that can join but not commit deadlocks the room. Default 1.5 CELO.
MIN_GAME_CELO_WEI=1500000000000000000

# ── Self-play cadence (randomized, budget-capped) ────────────────────────────
# Each self-play game waits a fresh RANDOM idle gap in [MIN,MAX] so games don't
# fire on a predictable clock. The AVERAGE of the range drives CELO spend; the
# spread only hides the pattern. A rolling-24h cap is the real budget guardrail.
# Defaults: 8h–12h → 2–3 games/day (24÷12=2 floor, 24÷8=3 ceiling, avg ~2.4).
# Keep MAX below 12h (43200000) to guarantee the 2-games/day floor.
SELF_PLAY_MIN_MS=28800000
SELF_PLAY_MAX_MS=43200000
SELF_PLAY_MAX_GAMES_PER_DAY=3

# ── Bot USDm loss budget (circuit breaker) ───────────────────────────────────
# Bots stake REAL USDm and can lose it to humans — that is an acquisition
# subsidy, not a self-funding mechanic. The runner tracks the pool's combined
# USDm against the day's opening balance and STOPS entering staked human rooms
# once the drawdown exceeds this budget (self-play is exempt: bots only pay
# each other). Topping the pool up re-marks the opening balance and releases
# the breaker. Default 0.05 USDm/day — raise deliberately, with a real budget.
BOT_DAILY_LOSS_BUDGET_WEI=50000000000000000
# Max bot seats in a single HUMAN room. 0 = uncapped (the current default):
# while human traffic is thin, a cap mainly stops our OWN testers getting a
# full room. Raise to 2-3 once real humans fill lobbies, at which point an
# all-bot table — farmable, and hollow enough that people don't return —
# becomes the thing worth preventing.
BOT_MAX_SEATS_PER_HUMAN_ROOM=0

# ── Bot wallet keys (fund at least 3, contiguous from _1; up to 10) ──────────
# Each needs native CELO for gas (>= MIN_GAME_CELO_WEI; ~5-10 CELO of runway)
# and a little USDm for stakes. A random subset of the FUNDED bots plays each
# game, so an under-funded bot is simply skipped, never stalls the room.
BOT_PRIVATE_KEY_1=0x...
BOT_PRIVATE_KEY_2=0x...
BOT_PRIVATE_KEY_3=0x...
BOT_PRIVATE_KEY_4=
BOT_PRIVATE_KEY_5=
BOT_PRIVATE_KEY_6=
BOT_PRIVATE_KEY_7=
BOT_PRIVATE_KEY_8=

# ── Telegram support bot ──────────────────────────────────────────────────────
# The bot has its own @username from BotFather; it triages the @zplague_xyz
# supergroup. Real values go in deploy/.env (gitignored) — never in this file.
# Token from @BotFather (/newbot). Required for the support-bot service.
TELEGRAM_BOT_TOKEN=
# Comma-separated NUMERIC Telegram user IDs paged for P0/P1 issues and allowed
# to run /stats and /resolve. Get yours from @userinfobot. Each operator must
# send /start to the bot once, or Telegram refuses to deliver the DM.
SUPPORT_ALERT_USER_IDS=

# ── X draft writer (@zplaguehq) ───────────────────────────────────────────────
# Writes one post a day about the game and sends it to Telegram. It does NOT
# post: no X API credentials appear here because the service has no X API
# client. Publishing stays manual. Setup: x-bot/README.md
#
# A SEPARATE BotFather bot from TELEGRAM_BOT_TOKEN above. The support bot is
# DM'd by players; this one should only be findable by whoever runs the account.
X_BOT_TELEGRAM_TOKEN=
# Comma-separated NUMERIC Telegram user IDs that receive drafts. Message the bot
# /whoami to get yours. Each must message it once before it can DM them.
X_OPERATOR_IDS=
# UTC hour the day's draft is written. Default 9. One per day regardless.
X_DRAFT_HOUR_UTC=9

# ── Ops watchdog alerts (backend) ─────────────────────────────────────────────
# Added after 2026-08-11, when the backend signer ran out of CELO and every
# phase transition failed silently for 100 hours. Six rooms froze mid-game while
# /health kept returning 200 — the HTTP server was fine, the signer was broke.
# The warning was in the logs the whole time and reached nobody.
#
# The watchdog checks three things every OPS_WATCHDOG_INTERVAL_MS:
#   - signer (and any OPS_WATCH_ADDRESSES) native CELO below OPS_MIN_SIGNER_WEI
#   - any live Active room whose phase clock has not moved in OPS_ROOM_STALL_MS
#   - activeRoomCount within 2 of maxActiveRooms (a stuck room holds its slot
#     forever, and at the cap createRoom reverts for humans too)
# It re-alerts on an unresolved issue at most once per OPS_ALERT_COOLDOWN_MS,
# and sends a one-shot recovery notice when a condition clears.
#
# Both channels are optional and independent. With NEITHER set the watchdog runs
# but only logs — which is the exact failure mode it exists to prevent, so it
# warns loudly at boot in that case.

# Telegram — the channel to TRUST. Reuses TELEGRAM_BOT_TOKEN above (the support
# bot); no second bot needed. Comma-separated NUMERIC user IDs from @userinfobot.
# Each operator must /start the bot in a DM once or Telegram silently refuses.
OPS_ALERT_TELEGRAM_IDS=

# Email — the AUDIT TRAIL, not the pager. Mail sent from a bare VPS IP to Gmail
# is frequently spam-foldered or rejected, and it will do that precisely when an
# alert matters. Do not make this the only channel.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<your address>,
# and SMTP_PASS=<a Google App Password>, NOT your account password (App
# Passwords need 2FA enabled: myaccount.google.com/apppasswords).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
OPS_ALERT_EMAIL_TO=

# Tuning — all optional, compose supplies these defaults.
# OPS_WATCHDOG_INTERVAL_MS=300000      # 5 min
# OPS_MIN_SIGNER_WEI=2000000000000000000  # 2 CELO (~4 ZK role commits of runway)
# OPS_ROOM_STALL_MS=900000             # 15 min; longest real phase is ~180s
# OPS_ALERT_COOLDOWN_MS=21600000       # 6h between repeats of the same alert
# Extra wallets to watch for low gas — bot runners pay their own. Comma-separated.
# OPS_WATCH_ADDRESSES=
